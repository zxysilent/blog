# 只在开发模式中被载入
VITE_PORT = 8001

# 网站根目录
VITE_PUBLIC_PATH = /



# 是否删除console
VITE_DROP_CONSOLE = false

# 跨域代理，可以配置多个，请注意不要换行
# 后端由 `fish run` 启动在 8085，接口路径自带 /api 前缀；
# 这里把 target 也写成带 /api 的形式，配合 createProxy 去掉前缀的改写规则，
# 最终请求为 http://127.0.0.1:8085/api/xxx，不需要改后端路由。
# /static 是后端的上传目录（图片/附件回显地址），开发环境一并代理过去，
# 否则封面等图片在 dev 下会 404（生产同源无此问题）。
VITE_PROXY = [["/api","http://127.0.0.1:8085/api"],["/static","http://127.0.0.1:8085/static"]]

# API 接口地址-留空走同源代理
VITE_GLOB_API_URL =

# 接口前缀
VITE_GLOB_API_URL_PREFIX = /api

# 文件上传地址
VITE_GLOB_UPLOAD_URL=

# 文件前缀地址
VITE_GLOB_FILE_URL=
