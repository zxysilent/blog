{
  "name": "blog-mgmt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && esno ./build/script/postBuild.ts",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "update-browserslist": "pnpm up caniuse-lite browserslist"
  },
  "dependencies": {
    "@vicons/antd": "^0.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vueup/vue-quill": "^1.2.0",
    "@vueuse/core": "^15.0.0",
    "alova": "^3.5.5",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "element-resize-detector": "^1.2.4",
    "lodash-es": "^4.17.21",
    "marked": "^18.1.2",
    "md-editor-v3": "7.1.0",
    "naive-ui": "^2.45.3",
    "pinia": "^2.3.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "^3.5.44",
    "autoprefixer": "^10.4.21",
    "chalk": "^6.0.1",
    "dotenv": "^18.0.8",
    "esno": "^4.8.0",
    "fs-extra": "^11.4.1",
    "less": "^4.9.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.7",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vue-tsc": "^3.3.13"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  },
  "//browserslist": "与 vite build.target=es2020 对齐：ES2020 即 Chrome87/Edge88/Firefox78/Safari14 起。显式指定后 autoprefixer 不再走 defaults（含大量遗留浏览器），产出的 CSS 前缀更少、体积更小。改动此列表需同步 docs/dev 浏览器要求。",
  "browserslist": [
    "chrome >= 87",
    "edge >= 88",
    "firefox >= 78",
    "safari >= 14",
    "ios_saf >= 14",
    "not dead"
  ]
}
