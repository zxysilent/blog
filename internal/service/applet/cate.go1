package applet

import (
	"blog/internal/model"
	"blog/internal/repo"
	"blog/internal/utils"
	"blog/pkg/reply"
	"time"

	"github.com/labstack/echo/v4"
)

// CateGet doc
// @Auth
// @Tags cate
// @Summary 分类单条数据
// @Param id query int true "id"
// @Security KeyAuth
// @Success 200 {object} utils.Reply{data=model.Cate} "返回数据"
// @Router /api/cate/get [get]
func CateGet(ctx echo.Context) error {
	ipt := &model.IptId{}
	err := ctx.Bind(ipt)
	if err != nil {
		return reply.Fail(ctx, "输入有误", err)
	}
	mod := &model.Cate{Id: ipt.Id}
	err = repo.CateGet(mod)
	if err != nil {
		return reply.Fail(ctx, "未查询到数据", err)
	}
	return reply.Succ(ctx, "succ", mod)
}

// CateTree doc
// @Auth
// @Tags cate
// @Summary 分类树形数据
// @Security KeyAuth
// @Param query query model.CateFilterList true "请求数据"
// @Success 200 {object} utils.Reply{data=[]model.Cate} "返回数据"
// @Router /api/cate/tree [get]
func CateTree(ctx echo.Context) error {
	ipt := &model.CateListArgs{}
	err := ctx.Bind(ipt)
	if err != nil {
		return reply.Fail(ctx, "输入有误", err)
	}
	mods, err := repo.CateList(ipt)
	if err != nil {
		return reply.Fail(ctx, "未查询到数据", err)
	}
	return ctx.JSON(utils.Succ("succ", mods))
}

// CateList doc
// @Auth
// @Tags cate
// @Summary 分类列表数据
// @Security KeyAuth
// @Param query query model.CateFilterList true "请求数据"
// @Success 200 {object} utils.Reply{data=[]model.Cate} "返回数据"
// @Router /api/cate/list [get]
func CateList(ctx echo.Context) error {
	ipt := &model.CateListArgs{}
	err := ctx.Bind(ipt)
	if err != nil {
		return reply.Fail(ctx, "输入有误", err)
	}
	mods, err := repo.CateList(ipt)
	if err != nil {
		return reply.Fail(ctx, "未查询到数据", err)
	}
	return ctx.JSON(utils.Succ("succ", mods))
}

// CatePage doc
// @Auth
// @Tags cate
// @Summary 获取分类分页
// @Security KeyAuth
// @Param query query model.CateFilterPage true "请求数据"
// @Success 200 {object} utils.Reply{data=[]model.Cate} "返回数据"
// @Router /api/cate/page [get]
func CatePage(ctx echo.Context) error {
	// cid, err := strconv.Atoi(ctx.Param("cid"))
	// if err != nil {
	//  return ctx.JSON(utils.ErrIpt("数据输入错误", err.Error()))
	// }
	ipt := &model.CateFilterPage{}
	err := ctx.Bind(ipt)
	if err != nil {
		return reply.Fail(ctx, "输入有误", err)
	}
	// if err = ipt.Stat(); err != nil {
	// 	return reply.Fail(ctx, "输入有误", err)
	// }
	mods, count, err := repo.CateList(ipt)
	if err != nil {
		return reply.Fail(ctx, "查询数据错误", err)
	}
	if count == 0 || len(mods) == 0 {
		return reply.Fail(ctx, "未查询到数据", "empty")

	}
	return reply.List(ctx, "succ", mods, count)
}

// CateAdd doc
// @Auth
// @Tags cate
// @Summary 分类添加数据
// @Security KeyAuth
// @Param body body model.Cate true "请求数据"
// @Success 200 {object} utils.Reply{data=string} "返回数据"
// @Router /api/cate/add [post]
func CateAdd(ctx echo.Context) error {
	ipt := &model.Cate{}
	err := ctx.Bind(ipt)
	if err != nil {
		return reply.Fail(ctx, "输入有误", err)
	}
	ipt.Updated = time.Now().UnixMilli()
	ipt.Created = ipt.Updated
	err = repo.CateAdd(ipt)
	if err != nil {
		return reply.Fail(ctx, "添加失败", err)
	}
	return reply.Succ(ctx, "succ")
}

// CateEdit doc
// @Auth
// @Tags cate
// @Summary 分类修改数据
// @Security KeyAuth
// @Param body body model.Cate true "请求数据"
// @Success 200 {object} utils.Reply{data=string} "返回数据"
// @Router /api/cate/edit [post]
func CateEdit(ctx echo.Context) error {
	ipt := &model.Cate{}
	err := ctx.Bind(ipt)
	if err != nil {
		return reply.Fail(ctx, "输入有误", err)
	}
	ipt.Updated = time.Now().UnixMilli()
	err = repo.CateEdit(ipt, "pid", "name", "color", "intro", "updated")
	if err != nil {
		return reply.Fail(ctx, "修改失败", err)
	}
	return reply.Succ(ctx, "succ")
}

// CateDrop doc
// @Auth
// @Tags cate
// @Summary 分类删除数据
// @Security KeyAuth
// @Param query query model.IptId true "请求数据"
// @Success 200 {object} utils.Reply{data=string} "返回数据"
// @Router /api/cate/drop [post]
func CateDrop(ctx echo.Context) error {
	ipt := &model.IptId{}
	err := ctx.Bind(ipt)
	if err != nil {
		return reply.Fail(ctx, "输入有误", err)
	}
	err = repo.CateDrop(&model.Cate{Id: ipt.Id})
	if err != nil {
		return reply.Fail(ctx, "删除失败", err)
	}
	return reply.Succ(ctx, "succ")
}
