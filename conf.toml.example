
title = "blog"
mode = "dev"
port = 8085
host = "0.0.0.0"
rpc_host = "0.0.0.0"
rpc_port = 1994
endpoint = ""

# 过期时间 h
token_exp = 24
# 加密私钥-一般要修改
token_secret ="secret"

# 数据库
[db]
# mysql\sqlite
type = "sqlite"
# uid:pass@tcp(host:port)/dbname?charset=utf8mb4&parseTime=true&loc=Local
mysql = "root:root@tcp(127.0.0.1:3306)/blog?charset=utf8mb4&parseTime=true&loc=Local"
sqlite = "file:blog.db"
show_sql = false

# 作者
[author]
name = "zxysilent"
website = "https://github.com/zxysilent"

